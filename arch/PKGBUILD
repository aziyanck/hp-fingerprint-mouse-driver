# Maintainer: aziyan
pkgname=hp-fingerprint-mouse-support
pkgver=1.0
pkgrel=1
pkgdesc="Native driver support and services for HP USB Fingerprint Mouse (Synaptics 06cb:00c3)"
arch=('any')
license=('GPL3' 'custom')
depends=(
    'python'
    'python-cryptography'
    'python-dbus'
    'python-gobject'
    'python-pyusb'
    'python-yaml'
    'fprintd'
    'usbutils'
)

package() {
    local src_dir="${srcdir}/.."

    # 1. Driver libraries
    install -d "${pkgdir}/usr/local/lib/hp-fingerprint-mouse"
    cp -r "${src_dir}/validitysensor" "${pkgdir}/usr/local/lib/hp-fingerprint-mouse/"
    cp -r "${src_dir}/openfprintd" "${pkgdir}/usr/local/lib/hp-fingerprint-mouse/"
    install -Dm755 "${src_dir}/python-validity-dbus/dbus-service" "${pkgdir}/usr/local/lib/hp-fingerprint-mouse/dbus-service"
    install -Dm755 "${src_dir}/openfprintd-dbus/open-fprintd" "${pkgdir}/usr/local/lib/hp-fingerprint-mouse/open-fprintd"

    # 2. Firmware microcode
    install -Dm644 "${src_dir}/firmware/6_07f_hp_mis_qm.xpfwext" "${pkgdir}/usr/share/python-validity/firmware/6_07f_hp_mis_qm.xpfwext"
    install -Dm644 "${src_dir}/firmware/6_07f_hp_mis_qm.xpfwext" "${pkgdir}/usr/share/python-validity/6_07f_hp_mis_qm.xpfwext"
    install -Dm644 "${src_dir}/firmware/6_07f_hp_mis_qm.xpfwext" "${pkgdir}/var/lib/python-validity/firmware/6_07f_hp_mis_qm.xpfwext"

    # 3. D-Bus policies
    install -Dm644 "${src_dir}/net.reactivated.Fprint.conf" "${pkgdir}/etc/dbus-1/system.d/net.reactivated.Fprint.conf"
    install -Dm644 "${src_dir}/io.github.uunicorn.Fprint.conf" "${pkgdir}/etc/dbus-1/system.d/io.github.uunicorn.Fprint.conf"

    # 4. udev rules
    install -Dm644 "${src_dir}/70-hp-fingerprint-mouse.rules" "${pkgdir}/etc/udev/rules.d/70-hp-fingerprint-mouse.rules"

    # 5. systemd services
    install -Dm644 "${src_dir}/open-fprintd.service" "${pkgdir}/etc/systemd/system/open-fprintd.service"
    install -Dm644 "${src_dir}/python3-validity.service" "${pkgdir}/etc/systemd/system/python3-validity.service"

    # 6. Diagnostic tool
    install -Dm755 "${src_dir}/test_hp_mouse.py" "${pkgdir}/usr/bin/hp-mouse-test"
}
