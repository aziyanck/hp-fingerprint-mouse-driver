[Unit]
Description=Open FPrint Daemon (HP Fingerprint Mouse D-Bus Backend)
Documentation=https://github.com/uunicorn/open-fprintd
Conflicts=fprintd.service

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=/usr/local/lib/hp-fingerprint-mouse/open-fprintd --debug
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
